# Brevo v3 API key (required for all data commands).
# Generate one at Brevo > SMTP & API > API Keys (https://app.brevo.com/settings/keys/api)
export BREVO_API_KEY="xkeysib-..."

# Optional: override the API base URL (HTTPS only). Defaults to
# https://api.brevo.com/v3
# export BREVO_API_URL="https://api.brevo.com/v3"
